{
  "name": "@agentactionverifier/core",
  "version": "0.1.0-alpha.0",
  "private": true,
  "publishConfig": { "access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./risk": {
      "types": "./dist/risk.d.ts",
      "import": "./dist/risk.js",
      "default": "./dist/risk.js"
    },
    "./grants": {
      "types": "./dist/grants.d.ts",
      "import": "./dist/grants.js",
      "default": "./dist/grants.js"
    },
    "./approvals": {
      "types": "./dist/approvals.d.ts",
      "import": "./dist/approvals.js",
      "default": "./dist/approvals.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "default": "./dist/credentials.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency.d.ts",
      "import": "./dist/idempotency.js",
      "default": "./dist/idempotency.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentactionverifier/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentactionverifier/aav.git",
    "directory": "packages/core"
  },
  "description": "AAV Local core — runtime security for AI agent actions",
  "homepage": "https://github.com/agentactionverifier/aav#readme",
  "bugs": { "url": "https://github.com/agentactionverifier/aav/issues" }
}
