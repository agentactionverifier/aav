{
  "name": "@agentactionverifier/protocol",
  "version": "0.1.0-alpha.0",
  "private": true,
  "publishConfig": { "access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js",
      "default": "./dist/audit.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js",
      "default": "./dist/canonical-json.js"
    },
    "./audit-chain": {
      "types": "./dist/audit-chain.d.ts",
      "import": "./dist/audit-chain.js",
      "default": "./dist/audit-chain.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentactionverifier/aav.git",
    "directory": "packages/protocol"
  },
  "description": "AAV Local protocol — runtime security for AI agent actions",
  "homepage": "https://github.com/agentactionverifier/aav#readme",
  "bugs": { "url": "https://github.com/agentactionverifier/aav/issues" }
}
