{
  "name": "@agentactionverifier/cli",
  "version": "0.1.0-alpha.0",
  "private": true,
  "publishConfig": { "access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "bin": {
    "aav": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentactionverifier/core": "workspace:*",
    "@agentactionverifier/gateway": "workspace:*",
    "@agentactionverifier/mcp": "workspace:*",
    "@agentactionverifier/protocol": "workspace:*",
    "@agentactionverifier/storage-sqlite": "workspace:*",
    "@agentactionverifier/verifier": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentactionverifier/aav.git",
    "directory": "packages/cli"
  },
  "description": "AAV Local cli — runtime security for AI agent actions",
  "homepage": "https://github.com/agentactionverifier/aav#readme",
  "bugs": { "url": "https://github.com/agentactionverifier/aav/issues" }
}
